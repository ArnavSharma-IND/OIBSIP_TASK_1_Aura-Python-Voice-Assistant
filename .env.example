# ==============================================================================
# ArnavSharma_Task1 – Python Voice Assistant Configuration Environment Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual values.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenWeatherMap API Configuration (For Live Weather Information)
# ------------------------------------------------------------------------------
# Sign up and generate a free API key at: https://home.openweathermap.org/users/sign_up
# Free tier allows 1,000 API calls/day (more than enough for daily voice queries).
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ------------------------------------------------------------------------------
# 2. SMTP Email Automation Configuration (Optional - for Sending Emails)
# ------------------------------------------------------------------------------
# For Gmail:
#   1. Enable 2-Step Verification in your Google Account security settings.
#   2. Generate an "App Password" at: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character App Password below (do not use your regular password).
# Note: If left blank or invalid, the assistant will run email commands in a safe
# simulated (dry-run) mode without failing.
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# ------------------------------------------------------------------------------
# 3. Assistant Personalization (Optional overrides for config.json)
# ------------------------------------------------------------------------------
ASSISTANT_USER_NAME=Arnav
ASSISTANT_NAME=Aura

